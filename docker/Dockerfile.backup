FROM postgres:17.6-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/* && mkdir /backups && chown postgres:postgres /backups
COPY docker/pg_backup.py /usr/local/bin/autohelp-backup.py
USER postgres
ENTRYPOINT ["python3", "/usr/local/bin/autohelp-backup.py"]
CMD ["--loop"]
